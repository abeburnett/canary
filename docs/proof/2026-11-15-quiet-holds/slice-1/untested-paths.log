"""Throwaway: run the slice-1 paths no committed test executes, on temp homes.
Every call passes home=, support= and ask=; nothing touches the real home."""
import os
import sys

sys.path[:0] = [os.getcwd(), os.path.join(os.getcwd(), "tests")]
from canary import watcher  # noqa: E402
from tests.test_watcher import Mac, drain, held_with_its_place_taken  # noqa: E402
from tests.test_replace import Home  # noqa: E402

real_home = os.path.realpath(os.path.expanduser("~"))


def check(label, ok, detail=""):
    print(("PASS " if ok else "FAIL ") + label + (f"  [{detail}]" if detail else ""))
    return ok


results = []

# 1. step -> SWEEP: the approved copy arrives after the hold, step queues one sweep.
mac, held_id, folder = held_with_its_place_taken()
assert mac.home != real_home and mac.home.startswith("/private/var") or "/T/" in mac.home, mac.home
first = mac.w.reviews.get_nowait()
results.append(check("hold id was on the queue first", first == held_id, first))
mac.w.step(20); mac.w.step(25); mac.w.step(30)
results.append(check("step set sweep_waiting", mac.w.sweep_waiting.is_set()))
queued = list(mac.w.reviews.queue)
results.append(check("step queued exactly one SWEEP", queued == [watcher.SWEEP], repr(queued)))
drain(mac.w)
results.append(check("sweep_waiting is clear after the sweep", not mac.w.sweep_waiting.is_set()))
results.append(check("the hold is dropped", mac.held() == [], repr(mac.held())))
results.append(check("one note, the installed note", len(mac.notes) == 1, repr(mac.notes)))
print("   note:", mac.notes)

# 2. handle step 4, hold stays: place taken by a copy that differs (.git), no question.
mac, held_id, folder = held_with_its_place_taken(git=True)
drain(mac.w)
results.append(check("hold stays", [h["id"] for h in mac.held()] == [held_id]))
results.append(check("no question asked", mac.asked == [mac.asked[0]] if mac.asked else True,
                     f"{len(mac.asked)} asked"))
print("   notes:", mac.notes)
results.append(check("taken note sent", any("place is taken" in n.lower() or "in its place" in n
                                             for n in mac.notes), repr(mac.notes)))

# 3. drop on a replaced group's id -> NOT_A_HOLD.
home = Home()
gid = home.replaced_group()
try:
    watcher.drop(gid, home.home, home.support, ask=lambda text, verdict: True)
    results.append(check("drop on a replaced id raises", False))
except ValueError as e:
    results.append(check("drop on a replaced id says NOT_A_HOLD",
                         str(e) == watcher.NOT_A_HOLD.format(id=gid), str(e)))

# 4. drop_text with the place taken, and the two-name note.
mac, held_id, folder = held_with_its_place_taken(git=True)
h = mac.held()[0]
text = watcher.drop_text(h, mac.home)
print("   drop_text:\n" + "\n".join("     | " + line for line in text.split("\n")))
results.append(check("drop_text says the place is taken", "Another copy is in its place now." in text))
note = watcher._installed_note(["a", "b"])
print("   two-name note:", note)
results.append(check("two-name note is section 1.2's plural",
                     note == "SkillCanary deleted 2 held copies that match skills you already "
                             "installed: a, b. canary list shows what is still held."))
results.append(check("drop_text's explanation is one line",
                     "Delete removes the copy SkillCanary is holding. This cannot be undone: to "
                     "get it back, install the skill again from where it came. Nothing in your "
                     "skills folders changes." in text.split("\n")))

print("ALL PASS" if all(results) else "SOME FAILED")
sys.exit(0 if all(results) else 1)
