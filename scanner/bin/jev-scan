#!/usr/bin/env python3
"""Deprecated entry point. Use `bin/canary scan`; this forwards to it.

Exit codes follow docs/architecture.md: 0 LIKELY_SAFE, 10 NEEDS_REVIEW,
20 UNSAFE, 2 usage error, 3 internal error. `--quarantine` is retired: it
copied the payload back into the skills directory. `canary add` quarantines
outside every discovery directory.
"""

import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, REPO)

from canary.cli import main  # noqa: E402

if __name__ == "__main__":
    args = sys.argv[1:]
    if "--quarantine" in args:
        print("jev-scan: --quarantine is retired; see docs/architecture.md", file=sys.stderr)
        sys.exit(2)
    print("jev-scan: deprecated, forwarding to `canary scan`", file=sys.stderr)
    sys.exit(main(["scan"] + args))
